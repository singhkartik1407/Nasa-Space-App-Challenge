# FireScope Frontend Configuration

# FastAPI Backend URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Data Mode (set to false for live backend API calls)
VITE_USE_MOCK_DATA=false

# Google Maps Platform (Optional: activates Google Maps deck.gl as the primary map provider)
# If left empty, FireScope uses high-performance MapLibre GL with OpenStreetMap raster tiles
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
